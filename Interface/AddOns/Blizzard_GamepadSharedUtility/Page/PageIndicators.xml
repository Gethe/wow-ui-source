<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">
	<Button name="GamepadPrevPageButtonTemplate" mixin="GamepadPageIndicatorMixin" virtual="true" hidden="true">
		<Size x="24" y="24"/>
		<NormalTexture atlas="common-icon-backarrow" useAtlasSize="false"/>
		<KeyValues>
			<KeyValue key="smartNavigationIgnored" value="true" type="boolean"/>
		</KeyValues>
	</Button>
	
	<Button name="GamepadNextPageButtonTemplate" mixin="GamepadPageIndicatorMixin" virtual="true" hidden="true">
		<Size x="24" y="24"/>
		<NormalTexture atlas="common-icon-forwardarrow" useAtlasSize="false"/>
		<KeyValues>
			<KeyValue key="smartNavigationIgnored" value="true" type="boolean"/>
		</KeyValues>
	</Button>
	
</Ui>
