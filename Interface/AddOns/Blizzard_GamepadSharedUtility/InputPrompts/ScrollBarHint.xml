<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">
	<Frame name="GamepadScrollBarHintTemplate" mixin="GamepadScrollBarHintMixin" hidden="true" virtual="true">
		<Size x="32" y="32"/>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
		<Layers>
			<Layer level="ARTWORK" textureSubLevel="1">
				<Texture parentKey="Texture" atlas="gamepad-xbox1-stick-updown-flat-normal">
					<Anchors>
						<Anchor point="TOPLEFT" x="-8" y="8"/>
						<Anchor point="BOTTOMRIGHT" x="8" y="-8"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>
	
	<Frame name="GamepadScrollBarHint" inherits="GamepadScrollBarHintTemplate" parent="UIParent"/>
</Ui>
