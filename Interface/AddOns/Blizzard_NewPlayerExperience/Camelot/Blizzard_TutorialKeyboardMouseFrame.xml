<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\..\..\..\WoW\Data\Interface\AddOns\Blizzard_SharedXML\UI.xsd">
	<Script file="Blizzard_TutorialKeyboardMouseFrame.lua" />

	<Frame name="TutorialKeyboardMouseFrame_Frame" mixin="TutorialKeyboardMouseFrameMixin" inherits="ResizeLayoutFrame" parent="UIParent" hidden="true" alpha="0" frameLevel="300" toplevel="true">
		<KeyValues>
			<KeyValue key="widthPadding" value="288" type="number"/>
			<KeyValue key="heightPadding" value="125" type="number"/>
		</KeyValues>
		<Anchors>
			<Anchor point="BOTTOM" y="104" />
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Keyboard" atlas="newplayertutorial-keyboard" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Text" text="NPEV2_INTRO_TO_MOUSE_AND_KEYBOARD" inherits="GameFontNormalHuge">
					<Color color="TUTORIAL_FONT_COLOR"/>
					<Anchors>
						<Anchor point="BOTTOM" relativeKey="$parent.Keyboard" relativePoint="TOP" y="29"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="KeyboardMouseConfirmButton" parentKey="ConfirmButton" inherits="UIPanelButtonTemplate" text="OKAY">
				<Size x="150" y="24"/>
				<Anchors>
					<Anchor point="TOP" relativeKey="$parent.Keyboard" relativePoint="BOTTOM" y="-5"/>
				</Anchors>
				<Scripts>
					<OnClick function="KeyboardMouseConfirmButton_OnClick"/>
				</Scripts>
			</Button>
			<Button name="SkipTutorialButton" parentKey="SkipTutorialButton" inherits="UIPanelButtonTemplate" text="NPEV2_SKIP_TUTORIAL_BUTTON" scale="0.9">
				<Size x="150" y="24"/>
				<Anchors>
					<Anchor point="TOP" relativeKey="$parent.ConfirmButton" relativePoint="BOTTOM" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="SkipTutorialPrompt" text="NPEV2_SKIP_TUTORIAL_PROMPT" inherits="GameFontNormalHuge">
							<Color color="TUTORIAL_FONT_COLOR"/>
							<Anchors>
								<Anchor point="RIGHT" relativePoint="LEFT" x="-20"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnShow>
						local gap = 20;
						local textWidth = self.SkipTutorialPrompt:GetStringWidth();
						self:ClearAllPoints();
						self:SetPoint("TOP", self:GetParent().ConfirmButton, "BOTTOM", (textWidth + gap) / 2, -30);
					</OnShow>
					<OnClick function="KeyboardMouseSkipTutorialButton_OnClick"/>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad" />
		</Scripts>
	</Frame>

	<Frame name="TutorialWalk_Frame" mixin="TutorialWalkMixin" inherits="ResizeLayoutFrame" parent="UIParent" alpha="0">
		<KeyValues>
			<KeyValue key="widthPadding" value="180" type="number"/>
			<KeyValue key="heightPadding" value="64" type="number"/>
		</KeyValues>
		<Anchors>
			<Anchor point="BOTTOM" y="232" />
		</Anchors>
		<Frames>
			<Frame parentKey="ContainerFrame" inherits="ResizeLayoutFrame" frameStrata="MEDIUM">
				<Anchors>
					<Anchor point="CENTER" />
				</Anchors>
				<Frames>
					<Frame parentKey="STRAFELEFT" inherits="KeyBindingTemplate">
						<Anchors>
							<Anchor point="LEFT" x="0" y="-15"/>
						</Anchors>
					</Frame>
					<Frame parentKey="MOVEBACKWARD" inherits="KeyBindingTemplate">
						<Anchors>
							<Anchor point="LEFT" relativeKey="$parent.STRAFELEFT" relativePoint="RIGHT" />
						</Anchors>
					</Frame>
					<Frame parentKey="MOVEFORWARD" inherits="KeyBindingTemplate">
						<Anchors>
							<Anchor point="BOTTOM" relativeKey="$parent.MOVEBACKWARD" relativePoint="TOP" />
						</Anchors>
					</Frame>
					<Frame parentKey="STRAFERIGHT" inherits="KeyBindingTemplate">
						<Anchors>
							<Anchor point="LEFT" relativeKey="$parent.MOVEBACKWARD" relativePoint="RIGHT" />
						</Anchors>
					</Frame>
				</Frames>
				<Layers>
					<Layer level="OVERLAY">
						<FontString parentKey="Text" text="NPEV2_INTRO_MOVE_ALLIANCE" inherits="GameFontNormalHuge2">
							<Color color="TUTORIAL_FONT_COLOR"/>
							<Anchors>
								<Anchor point="LEFT" relativeKey="$parent.STRAFERIGHT" relativePoint="RIGHT" x="20" y="15"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad" />
		</Scripts>
	</Frame>
	
</Ui>
