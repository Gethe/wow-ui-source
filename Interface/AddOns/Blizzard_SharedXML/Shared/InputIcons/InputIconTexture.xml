<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\UI.xsd">
	<Frame name="InputIconTextureFrameTemplate" virtual="true" mixin="InputIconTextureMixin">
		<Size x="24" y="24"/>
		<KeyValues>
			<KeyValue key="useDropShadow" value="false" type="boolean"/>
		</KeyValues>
		<Layers>
			<Layer level="ARTWORK" textureSubLevel="1">
				<Texture name="$parentNormalTexture" parentKey="NormalTexture" hidden="true" />
				<Texture name="$parentHoverTexture" parentKey="HoverTexture" hidden="true "/>
				<Texture name="$parentPressedTexture" parentKey="PressedTexture" hidden="true "/>
				<Texture name="$parentActiveTexture" parentKey="ActiveTexture" hidden="true "/>
				<Texture name="$parentDisabledTexture" parentKey="DisabledTexture" hidden="true "/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
