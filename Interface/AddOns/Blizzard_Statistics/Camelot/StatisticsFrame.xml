<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">
	<Button name="StatisticsHeaderTemplate" mixin="StatisticsHeaderMixin" virtual="true">
		<Size y="26"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture atlas="common-button-list-collapseExpand" useAtlasSize="true"/>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture atlas="common-button-list-collapseExpand" alphaMode="ADD" alpha="0.3" useAtlasSize="true"/>
			</Layer>
			<Layer level="BORDER">
				<Texture parentKey="StateIcon" useAtlasSize="true">
					<Anchors>
						<Anchor point="RIGHT" x="-8" y="-1"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Name" inherits="GameFontNormalLeft">
					<Size y="15"/>
					<Anchors>
						<Anchor point="LEFT" x="10"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<Button name="StatisticsEntryTemplate" mixin="StatisticsEntryMixin" virtual="true">
		<Size y="24"/>
		<Frames>
			<Frame parentKey="Content" setAllPoints="true">
				<Frames>
					<Frame parentKey="BackgroundHighlight" alpha="0" setAllPoints="true">
						<Layers>
							<Layer level="BACKGROUND">
								<Texture parentKey="Left" atlas="charactercreate-customize-dropdown-linemouseover-side" parentArray="TextureRegions">
									<Size x="6"/>
									<Anchors>
										<Anchor point="TOPLEFT"/>
										<Anchor point="BOTTOMLEFT"/>
									</Anchors>
								</Texture>
								<Texture parentKey="Right" atlas="charactercreate-customize-dropdown-linemouseover-side" parentArray="TextureRegions">
									<Size x="6"/>
									<TexCoords left="1" right="0" top="0" bottom="1"/>
									<Anchors>
										<Anchor point="TOPRIGHT"/>
										<Anchor point="BOTTOMRIGHT"/>
									</Anchors>
								</Texture>
								<Texture parentKey="Middle" atlas="charactercreate-customize-dropdown-linemouseover-middle" parentArray="TextureRegions">
									<Anchors>
										<Anchor point="TOPLEFT" relativeKey="$parent.Left" relativePoint="TOPRIGHT"/>
										<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Right" relativePoint="BOTTOMLEFT"/>
									</Anchors>
								</Texture>
							</Layer>
						</Layers>
					</Frame>
				</Frames>
				<Layers>
					<Layer level="OVERLAY">
						<FontString parentKey="Value" inherits="GameFontHighlight" justifyH="RIGHT">
							<Size x="50" y="15"/>
							<Anchors>
								<Anchor point="RIGHT" x="-12"/>
							</Anchors>
						</FontString>
						<FontString parentKey="Name" inherits="GameFontHighlight" justifyH="LEFT">
							<Size y="15"/>
							<Anchors>
								<Anchor point="LEFT" x="2"/>
								<Anchor point="RIGHT" relativeKey="$parent.Value" relativePoint="LEFT" x="-10"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<Button name="StatisticsSubHeaderTemplate" inherits="StatisticsEntryTemplate" mixin="StatisticsSubHeaderMixin" virtual="true">
		<Size y="22"/>
		<Frames>
			<Button parentKey="ToggleCollapseButton" mixin="StatisticsSubHeaderToggleCollapseButtonMixin">
				<Size x="20" y="20"/>
				<Anchors>
					<Anchor point="LEFT" x="2"/>
				</Anchors>
				<Scripts>
					<OnClick method="OnClick"/>
				</Scripts>
				<NormalTexture atlas="campaign_headericon_closed" useAtlasSize="true"/>
				<PushedTexture atlas="campaign_headericon_closedpressed" useAtlasSize="true"/>
				<HighlightTexture file="Interface\Buttons\UI-PlusButton-Hilight" alphaMode="ADD"/>
			</Button>
		</Frames>
	</Button>

	<Frame name="StatisticsFrame" setAllPoints="true" enableMouse="true" parent="CharacterFrame" useParentLevel="true" mixin="StatisticsFrameMixin" hidden="true" id="6">
		<Frames>
			<Frame parentKey="ScrollBox" inherits="WowScrollBoxList" frameStrata="HIGH">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="CharacterFrameLeftPaneHost" x="10" y="-40"/>
					<Anchor point="BOTTOMRIGHT" relativeTo="CharacterFrameLeftPaneHost" x="-25" y="15"/>
				</Anchors>
				<Frames>
					<Frame frameLevel="6">
						<Size x="1" y="1"/>
						<Anchors>
							<Anchor point="TOP"/>
						</Anchors>
						<Layers>
							<Layer level="OVERLAY">
								<Texture atlas="UI-Character-Info-ScrollLine-Long" useAtlasSize="true">
									<Anchors>
										<Anchor point="CENTER"/>
									</Anchors>
								</Texture>
							</Layer>
						</Layers>
					</Frame>
					<Frame frameLevel="6">
						<Size x="1" y="1"/>
						<Anchors>
							<Anchor point="BOTTOM"/>
						</Anchors>
						<Layers>
							<Layer level="OVERLAY">
								<Texture atlas="UI-Character-Info-ScrollLine-Long" useAtlasSize="true">
									<Anchors>
										<Anchor point="CENTER"/>
									</Anchors>
								</Texture>
							</Layer>
						</Layers>
					</Frame>
				</Frames>
			</Frame>

			<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar" frameStrata="HIGH">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="5" y="-2"/>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT" x="5" y="4"/>
				</Anchors>
			</EventFrame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEvent method="OnEvent"/>
		</Scripts>
	</Frame>
</Ui>
