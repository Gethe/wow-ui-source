<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<CheckButton name="GamepadPetActionFlyoutButtonTemplate" inherits="GamepadFlyoutPopupButtonBaseTemplate" virtual="true" hidden="true">
		<Mixins>
			<Mixin key="GamepadFlyoutPopupButtonMixin"/>
			<Mixin key="GamepadPetActionFlyoutButtonMixin"/>
		</Mixins>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEvent method="OnEvent"/>
			<OnClick method="OnClick"/>
		</Scripts>
	</CheckButton>

	<Frame name="GamepadPetActionFlyout" toplevel="true" hidden="true" inherits="GamepadFlyoutTemplate">
		<Mixins>
			<Mixin key="GamepadPetActionFlyoutMixin"/>
		</Mixins>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
		<Frames>
			<CheckButton parentKey="AttackButton" parentArray="buttons" inherits="GamepadPetActionFlyoutButtonTemplate">
				<KeyValues>
					<KeyValue key="actionType" type="string" value="PET_ACTION_ATTACK"/>
					<KeyValue key="layoutIndex" type="number" value="1"/>
				</KeyValues>
				<Scripts>
					<OnLoad method="OnLoad"/>
					<OnShow method="OnShow"/>
					<OnHide method="OnHide"/>
					<OnEvent method="OnEvent"/>
				</Scripts>
			</CheckButton>
			<CheckButton parentKey="FollowButton" parentArray="buttons" inherits="GamepadPetActionFlyoutButtonTemplate">
				<KeyValues>
					<KeyValue key="actionType" type="string" value="PET_ACTION_FOLLOW"/>
					<KeyValue key="layoutIndex" type="number" value="2"/>
				</KeyValues>
			</CheckButton>
			<CheckButton parentKey="MoveToButton" parentArray="buttons" inherits="GamepadPetActionFlyoutButtonTemplate">
				<KeyValues>
					<KeyValue key="actionType" type="string" value="PET_ACTION_MOVE_TO"/>
					<KeyValue key="layoutIndex" type="number" value="3"/>
				</KeyValues>
			</CheckButton>
			<!-- Intentional layoutIndex gap -->
			<CheckButton parentKey="PassiveButton" parentArray="buttons" inherits="GamepadPetActionFlyoutButtonTemplate">
				<KeyValues>
					<KeyValue key="actionType" type="string" value="PET_MODE_PASSIVE"/>
					<KeyValue key="layoutIndex" type="number" value="5"/>
				</KeyValues>
			</CheckButton>
			<CheckButton parentKey="DefensiveButton" parentArray="buttons" inherits="GamepadPetActionFlyoutButtonTemplate">
				<KeyValues>
					<KeyValue key="actionType" type="string" value="PET_MODE_DEFENSIVEASSIST"/>
					<KeyValue key="layoutIndex" type="number" value="6"/>
				</KeyValues>
			</CheckButton>
			<CheckButton parentKey="AssistButton" parentArray="buttons" inherits="GamepadPetActionFlyoutButtonTemplate">
				<KeyValues>
					<KeyValue key="actionType" type="string" value="PET_MODE_ASSIST"/>
					<KeyValue key="layoutIndex" type="number" value="7"/>
				</KeyValues>
			</CheckButton>
		</Frames>
	</Frame>

	<Frame name="GamepadPetSpellFlyout" toplevel="true" hidden="true" inherits="GamepadFlyoutTemplate">
		<Mixins>
			<Mixin key="GamepadPetSpellFlyoutMixin"/>
		</Mixins>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
		</Scripts>
		<KeyValues>
			<KeyValue key="buttonTemplate" type="string" value="GamepadPetActionFlyoutButtonTemplate"/>
		</KeyValues>
		<Frames>
		</Frames>
	</Frame>

</Ui>
