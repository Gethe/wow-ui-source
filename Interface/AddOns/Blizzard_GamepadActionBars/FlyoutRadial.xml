<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\Blizzard_SharedXML\UI.xsd">

	<CheckButton name="GamepadSpellFlyoutPopupButtonTemplate" inherits="SpellFlyoutPopupButtonTemplate" virtual="true">
		<Size x="32" y="32"/>
		<Mixins>
			<Mixin key="GamepadSpellFlyoutPopupButtonMixin"/>
		</Mixins>
		<DisabledTexture parentKey="DisabledTexture"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="CheckedOverlayTexture"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEvent method="OnEvent"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</CheckButton>

	<Frame name="GamepadSpellFlyout" toplevel="true" hidden="true" frameStrata="DIALOG" frameLevel="10" inherits="SecureFrameTemplate">
		<Size x="200" y="200"/>
		<Mixins>
			<Mixin key="FlyoutPopupMixin"/>
			<Mixin key="GamepadSpellFlyoutMixin"/>
		</Mixins>
		<KeyValues>
			<KeyValue key="buttonTemplate" type="string" value="GamepadSpellFlyoutPopupButtonTemplate"/>
			<KeyValue key="showAllRanks" type="boolean" value="false"/>
		</KeyValues>
		<Layers>
			<Layer level="BACKGROUND" textureSubLevel="0">
				<Texture parentKey="Background">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BACKGROUND" textureSubLevel="1">
				<Texture parentKey="SlotBackdrop1" parentArray="SlotBackdrops"/>
				<Texture parentKey="SlotBackdrop2" parentArray="SlotBackdrops"/>
				<Texture parentKey="SlotBackdrop3" parentArray="SlotBackdrops"/>
				<Texture parentKey="SlotBackdrop4" parentArray="SlotBackdrops"/>
				<Texture parentKey="SlotBackdrop5" parentArray="SlotBackdrops"/>
				<Texture parentKey="SlotBackdrop6" parentArray="SlotBackdrops"/>
				<Texture parentKey="SlotBackdrop7" parentArray="SlotBackdrops"/>
				<Texture parentKey="SlotBackdrop8" parentArray="SlotBackdrops"/>
			</Layer>
			<Layer level="BACKGROUND" textureSubLevel="2">
				<Texture parentKey="SelectionIndicator" atlas="gamepad-flyout-selection-indicator" useAtlasSize="true" hidden="true">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEvent method="OnEvent"/>
		</Scripts>
		<Frames>
			<Frame parentKey="SelectionArrow" hidden="true">
				<Size x="21" y="35"/>
				<Layers>
					<Layer level="OVERLAY">
						<Texture parentKey="Texture" atlas="gamepad-largecursor" setAllPoints="true"/>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
	</Frame>

</Ui>
