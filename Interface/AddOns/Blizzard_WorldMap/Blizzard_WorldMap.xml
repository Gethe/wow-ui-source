<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\..\..\WoW\Data\Interface\AddOns\Blizzard_SharedXML\UI.xsd">

	<Frame name="WorldMapFrameTemplate" inherits="MapCanvasFrameTemplate" mixin="QuestLogOwnerMixin, WorldMapMixin" virtual="true">
		<Frames>
			<Frame parentKey="TitleCanvasSpacerFrame">
				<Anchors>
					<Anchor point="TOPLEFT" x="2" y="0"/>
				</Anchors>
			</Frame>
			<ScrollFrame parentKey="ScrollContainer" inherits="MapCanvasFrameScrollContainerTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.TitleCanvasSpacerFrame" relativePoint="BOTTOMLEFT" x="0" y="0"/>
					<Anchor point="BOTTOMLEFT" x="0" y="2"/>
					<Anchor point="RIGHT" relativeKey="$parent.TitleCanvasSpacerFrame"/>
				</Anchors>
			</ScrollFrame>
			<Frame parentKey="OverscrollBG" >
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollContainer"/>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollContainer"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND" textureSubLevel="-1">
						<Texture parentKey="Texture" atlas="gamepad-mapquestlog-bgtile-2k" horizTile="true" vertTile="true" setAllPoints="true" />
					</Layer>
					<Layer level="BACKGROUND" textureSubLevel="0">
						<Texture parentKey="TopLeftVignette" atlas="gamepad-mapquestlog-bg-vignette" useAtlasSize="true">
							<Anchors>
								<Anchor point="TOPLEFT"/>
								<Anchor point="BOTTOMRIGHT" relativeKey="$parent" relativePoint="CENTER"/>
							</Anchors>
						</Texture>
						<Texture parentKey="TopRightVignette" atlas="gamepad-mapquestlog-bg-vignette" useAtlasSize="true" >
							<TexCoords left="1" right="0"/>
							<Anchors>
								<Anchor point="TOPRIGHT"/>
								<Anchor point="BOTTOMLEFT" relativeKey="$parent" relativePoint="CENTER"/>
							</Anchors>
						</Texture>
						<Texture parentKey="BottomLeftVignette" atlas="gamepad-mapquestlog-bg-vignette" useAtlasSize="true" >
							<TexCoords top="1" bottom="0"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT"/>
								<Anchor point="TOPRIGHT" relativeKey="$parent" relativePoint="CENTER"/>
							</Anchors>
						</Texture>
						<Texture parentKey="BottomRightVignette" atlas="gamepad-mapquestlog-bg-vignette" useAtlasSize="true" >
							<TexCoords left="1" right="0" top="1" bottom="0" />
							<Anchors>
								<Anchor point="BOTTOMRIGHT"/>
								<Anchor point="TOPLEFT" relativeKey="$parent" relativePoint="CENTER"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnEvent method="OnEvent"/>
			<OnHide method="OnHide"/>
		</Scripts>
	</Frame>

	<Frame name="WorldMapFrame" mixin="FocusFramesInterfaceMixin" inherits="WorldMapFrameTemplate" parent="UIParent" frameBuffer="true">
		<KeyValues>
			<KeyValue key="FocusFrameParent" value="BorderFrame" type="string"/>
		</KeyValues>
		<Frames>
			<Frame parentKey="BlackoutFrame" frameStrata="LOW" enableMouse="true">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="UIParent"/>
					<Anchor point="BOTTOMRIGHT" relativeTo="UIParent"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture parentKey="Blackout" setAllPoints="true">
							<Color r="0" g="0" b="0" a="1"/>
						</Texture>
					</Layer>
				</Layers>
			</Frame>
			<Frame parentKey="BorderFrame" inherits="PortraitFrameTemplateMinimizable" frameStrata="HIGH" setAllPoints="true">
				<Layers>
					<Layer level="ARTWORK" textureSubLevel="5">
						<Texture parentKey="Underlay" hidden="true">
							<Color r="0" g="0" b="0" a=".5"/>
						</Texture>
					</Layer>
					<Layer level="BACKGROUND" textureSubLevel="-5">
						<Texture inherits="_UI-Frame-InnerTopTile" parentKey="InsetBorderTop">
							<Size x="0" y="3"/>
							<Anchors>
								<Anchor point="TOPLEFT" x="2" y="-63"/>
								<Anchor point="RIGHT" relativeKey="$parent.$parent.ScrollContainer"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
				<Frames>
					<Button parentKey="Tutorial" inherits="MainHelpPlateButton" mixin="WorldMapTutorialMixin">
						<Anchors>
							<Anchor point="TOPLEFT" x="43" y="19"/>
						</Anchors>
						<Scripts>
							<OnLoad method="OnLoad"/>
							<OnHide method="OnHide"/>
							<OnClick method="ToggleHelpInfo"/>
						</Scripts>
					</Button>
					<Frame parentKey="MaximizeMinimizeFrame" inherits="MaximizeMinimizeButtonFrameTemplate">
						<Anchors>
							<Anchor point="RIGHT" relativeKey="$parent.CloseButton" relativePoint="LEFT" x="-1" y="0"/>
						</Anchors>
					</Frame>
				</Frames>
				<Scripts>
					<OnLoad>
						self.onCloseCallback = function() HideParentPanel(self) end;
					</OnLoad>
					<OnMouseWheel function="nop" />
				</Scripts>
			</Frame>
			<Frame parentKey="GamepadFocusLeftDirectionalIcon" inherits="InputIconTextureFrameTemplate" frameStrata="DIALOG" hidden="true">
				<KeyValues>
					<KeyValue key="mappedButtonKey" value="GAMEPAD_DPAD_LEFT" type="global"/>
					<KeyValue key="useDropShadow" value="true" type="boolean"/>
				</KeyValues>
				<Size x="30" y="30"/>
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.ScrollContainer" x="-5" y="0" />
				</Anchors>
			</Frame>
			<Frame parentKey="GamepadFocusRightDirectionalIcon" inherits="InputIconTextureFrameTemplate" frameStrata="DIALOG" hidden="true">
				<KeyValues>
					<KeyValue key="mappedButtonKey" value="GAMEPAD_DPAD_RIGHT" type="global"/>
					<KeyValue key="useDropShadow" value="true" type="boolean"/>
				</KeyValues>
				<Size x="30" y="30"/>
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.ScrollContainer" x="-5" y="0" />
				</Anchors>
			</Frame>
			<Frame parentKey="GamepadFocusUpDirectionalIcon" inherits="InputIconTextureFrameTemplate" frameStrata="DIALOG" hidden="true">
				<KeyValues>
					<KeyValue key="mappedButtonKey" value="GAMEPAD_DPAD_TOP" type="global"/>
					<KeyValue key="useDropShadow" value="true" type="boolean"/>
				</KeyValues>
				<Size x="30" y="30"/>
				<Anchors>
					<Anchor point="TOP" relativeKey="$parent.ScrollContainer" x="0" y="-5" />
				</Anchors>
			</Frame>
			<Frame parentKey="GamepadFocusDownDirectionalIcon" inherits="InputIconTextureFrameTemplate" frameStrata="DIALOG" hidden="true">
				<KeyValues>
					<KeyValue key="mappedButtonKey" value="GAMEPAD_DPAD_BOTTOM" type="global"/>
					<KeyValue key="useDropShadow" value="true" type="boolean"/>
				</KeyValues>
				<Size x="30" y="30"/>
				<Anchors>
					<Anchor point="TOP" relativeKey="$parent.ScrollContainer" x="0" y="-5" />
				</Anchors>
			</Frame>
		</Frames>
	</Frame>
</Ui>
