<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\..\..\..\WoW\Data\Interface\AddOns\Blizzard_SharedXML\UI.xsd">

	<DropdownButton name="WorldMapTrackingOptionsButtonTemplate" frameStrata="HIGH" mixin="WorldMapTrackingOptionsButtonMixin" virtual="true">
		<KeyValues>
			<KeyValue key="buttonContext" value="ButtonContext_WorldMapTrackingButton" type="string"/>
			<KeyValue key="mouseUpAtlas" value="common-dropdown-a-button" type="string"/>
			<KeyValue key="mouseDownAtlas" value="common-dropdown-a-button-pressed" type="string"/>
		</KeyValues>
		<Size x="32" y="32"/>
		<KeyValues>
			<!-- Place the indicator farther left to avoid overlapping the filter counter banner -->
			<KeyValue key="customSmartNavOffsetX" value="-20" type="number"/> 
		</KeyValues>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" atlas="common-dropdown-a-button" useAtlasSize="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="4" y="-6"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button parentKey="ResetButton" inherits="UIResetButtonTemplate">
				<Anchors>
					<Anchor point="CENTER" relativePoint="TOPRIGHT" x="-5" y="-7"/>
				</Anchors>
			</Button>
		</Frames>
		<HighlightTexture alphaMode="ADD" atlas="common-dropdown-a-button" alpha="0.4" useAtlasSize="true">
		<Anchors>
			<Anchor point="TOPLEFT" x="4" y="-6"/>
		</Anchors>
		</HighlightTexture>
		
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnEnter method="OnEnter"/>
			<OnLeave function="GameTooltip_Hide"/>
		</Scripts>
	</DropdownButton>

</Ui>
