			<KeyValue key="buttonContext" value="ButtonContext_MinimapHeader" type="string"/>
			<KeyValue key="mouseoverAddAlpha" type="number" value="0.1"/>
			<KeyValue key="mousedownAddAlpha" type="number" value="0.2"/>
		</KeyValues>
		<Size x="23" y="23"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="StateTexture" atlas="ui-hud-minimap-tracking-button" useAtlasSize="true"/>
				<Texture parentKey="AddTexture" atlas="ui-hud-minimap-tracking-button" useAtlasSize="true" hidden="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnEnable method="OnEnable"/>
			<OnDisable method="OnDisable"/>
		</Scripts>
	</DropdownButton>
</Ui>
