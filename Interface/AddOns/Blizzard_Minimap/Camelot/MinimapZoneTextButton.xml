<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">
	<Button name="MinimapZoneTextButtonTemplate" virtual="true" mixin="MinimapZoneTextButtonMixin">
		<KeyValues>
			<KeyValue key="buttonContext" value="ButtonContext_MinimapHeader" type="string"/>
			<KeyValue key="mouseoverAddAlpha" type="number" value="0.1"/>
			<KeyValue key="mousedownAddAlpha" type="number" value="0.2"/>
		</KeyValues>
		<Size x="152" y="23"/>
		<Anchors>
			<Anchor point="TOP" x="10" y="0"/>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="StateTexture" atlas="ui-hud-minimap-header-button" useAtlasSize="true"/>
				<Texture parentKey="AddTexture" atlas="ui-hud-minimap-header-button" useAtlasSize="true" hidden="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<FontString name="MinimapZoneText" inherits="GameFontHighlightSmall" nonspacewrap="true" justifyH="LEFT" justifyV="MIDDLE">
					<Size x="110" y="12"/>
					<Anchors>
						<Anchor point="LEFT" x="8" y="-1"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<OnEnter method="OnEnter"/>
			<OnClick method="OnClick"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnEnable method="OnEnable"/>
			<OnDisable method="OnDisable"/>
		</Scripts>
	</Button>
</Ui>
