<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">
	<DropdownButton name="MiniMapTrackingButtonTemplate" virtual="true" mixin="MiniMapTrackingButtonMixin">
		<KeyValues>
			<KeyValue key="menuPoint" type="string" value="TOPRIGHT"/>
			<KeyValue key="menuRelativePoint" type="string" value="BOTTOMLEFT"/>
			<KeyValue key="buttonContext" value="ButtonContext_MinimapHeader" type="string"/>
			<KeyValue key="normalAtlas" type="string" value="ui-hud-minimap-tracking-up"/>
			<KeyValue key="pressedAtlas" type="string" value="ui-hud-minimap-tracking-down"/>
			<KeyValue key="mouseoverAtlas" type="string" value="ui-hud-minimap-tracking-mouseover"/>
		</KeyValues>
		<Size x="13" y="14"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="StateTexture" atlas="ui-hud-minimap-tracking-up" useAtlasSize="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnEnable method="OnEnable"/>
			<OnDisable method="OnDisable"/>
		</Scripts>
	</DropdownButton>
</Ui>