<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">
	<DropdownButton name="AddonCompartmentFrame" parent="MinimapCluster" mixin="AddonCompartmentMixin">
		<KeyValues>
			<KeyValue key="menuPoint" type="string" value="TOPRIGHT"/>
			<KeyValue key="normalAtlas" type="string" value="ui-hud-minimap-button"/>
			<KeyValue key="pressedAtlas" type="string" value="ui-hud-minimap-button-down"/>
			<KeyValue key="mouseoverAtlas" type="string" value="ui-hud-minimap-button"/>
		</KeyValues>
		<Size x="16" y="16"/>
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="GameTimeFrame" relativePoint="BOTTOMLEFT" x="0" y="0"/>
		</Anchors>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnEnable method="OnEnable"/>
			<OnDisable method="OnDisable"/>
		</Scripts>
		<NormalFont style="GameFontHighlightSmall"/>
		<ButtonText parentKey="Text" text="0" setAllPoints="true">
			<Anchors>
				<Anchor point="CENTER" x="1" y="0"/>
			</Anchors>
		</ButtonText>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="StateTexture" atlas="ui-hud-minimap-button" useAtlasSize="true"/>
			</Layer>
		</Layers>
	</DropdownButton>
</Ui>
