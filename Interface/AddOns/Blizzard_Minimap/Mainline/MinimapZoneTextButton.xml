<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">
	<Button name="MinimapZoneTextButtonTemplate" virtual="true" mixin="MinimapZoneTextButtonMixin">
		<KeyValues>
			<KeyValue key="buttonContext" value="ButtonContext_MinimapHeader" type="string"/>
		</KeyValues>
		<Size x="175" y="12"/>
		<Anchors>
			<Anchor point="TOP" x="0" y="-6"/>
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="MinimapZoneText" inherits="GameFontNormal" nonspacewrap="true" justifyH="LEFT" justifyV="MIDDLE">
					<Size x="130" y="12"/>
					<Anchors>
						<Anchor point="LEFT" x="4" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="BorderTop" inherits="NineSliceCodeTemplate" useParentLevel="true">
				<KeyValues>
					<KeyValue key="layoutType" value="UniqueCornersLayout" type="string"/>
					<KeyValue key="layoutTextureKit" value="ui-hud-minimap-button" type="string"/>
				</KeyValues>
				<Size x="175" y="16"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="0" y="2"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<OnEnter method="OnEnter"/>
			<OnClick method="OnClick"/>
			<OnLeave method="OnLeave"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnEnable method="OnEnable"/>
			<OnDisable method="OnDisable"/>
		</Scripts>
	</Button>
</Ui>
