<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">
	<Frame name="InspectPVPFrame" mixin="InspectPVPFrameMixin" setAllPoints="true" enableMouse="true" parent="InspectFrame" useParentLevel="true" hidden="true" id="2">
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="SeasonTimerField" inherits="GameFontNormal" justifyH="RIGHT" hidden="true">
					<Anchors>
						<Anchor point="TOPRIGHT" relativeTo="InspectFrameInset" x="-10" y="-16"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="MainInfoFrame">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="InspectFrameInset" x="4" y="-4"/>
					<Anchor point="BOTTOMRIGHT" relativeTo="InspectFrameInset" x="-4" y="4"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="CurrentSeasonField" inherits="GameFontNormalMed2" justifyH="CENTER">
							<Anchors>
								<Anchor point="TOP" x="0" y="-20"/>
							</Anchors>
						</FontString>
						<FontString parentKey="CurrentRankField" inherits="GameFontHighlightLarge" justifyH="CENTER">
							<Anchors>
								<Anchor point="TOP" relativeKey="$parent.CurrentSeasonField" relativePoint="BOTTOM" x="0" y="10"/>
							</Anchors>
						</FontString>
						<FontString parentKey="CurrentRankProgressField" inherits="GameFontNormal" justifyH="CENTER">
							<Anchors>
								<Anchor point="TOP" relativeKey="$parent.CurrentRankField" relativePoint="BOTTOM" x="0" y="-210"/>
							</Anchors>
						</FontString>
						<FontString parentKey="HonorableKillsField" inherits="GameFontNormal" justifyH="CENTER">
							<Anchors>
								<Anchor point="TOP" relativeKey="$parent.CurrentRankProgressField" relativePoint="BOTTOM" x="0" y="-8"/>
							</Anchors>
						</FontString>
						<FontString parentKey="LifetimeHKsField" inherits="GameFontNormal" justifyH="CENTER">
							<Anchors>
								<Anchor point="TOP" relativeKey="$parent.HonorableKillsField" relativePoint="BOTTOM" x="0" y="-6"/>
							</Anchors>
						</FontString>
						<FontString parentKey="TodayHKsField" inherits="GameFontNormal" justifyH="CENTER">
							<Anchors>
								<Anchor point="TOP" relativeKey="$parent.LifetimeHKsField" relativePoint="BOTTOM" x="0" y="-6"/>
							</Anchors>
						</FontString>
						<Texture parentKey="Line" atlas="UI-Character-Info-Honor-LevelBG" useAtlasSize="true">
							<Anchors>
								<Anchor point="BOTTOM" relativeKey="$parent.CurrentRankField" relativePoint="BOTTOM" y="-10"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
				<Frames>
					<Cooldown parentKey="RankProgressBarDisplay" reverse="true" hideCountdownNumbers="true" scale=".9" rotation="180" mixin="InspectPVPRankProgressBarDisplayMixin">
						<Size x="154" y="154"/>
						<Anchors>
							<Anchor point="TOP" x="0" y="-85"/>
						</Anchors>
						<Layers>
							<Layer level="BACKGROUND" textureSubLevel="0">
								<Texture atlas="UI-Character-Info-Honor-Bar-BG-Glow">
									<Size x="275" y="295"/>
									<Anchors>
										<Anchor point="CENTER"/>
									</Anchors>
								</Texture>
							</Layer>
							<Layer level="BACKGROUND" textureSubLevel="0">
								<Texture parentKey="Background">
									<Size x="115" y="115"/>
									<Anchors>
										<Anchor point="CENTER"/>
									</Anchors>
								</Texture>
							</Layer>
							<Layer level="BORDER">
								<Texture parentKey="Bar" atlas="pvpqueue-sidebar-honorbar-background">
									<Size x="235" y="209"/>
									<Anchors>
										<Anchor point="CENTER" x="0" y="-1"/>
									</Anchors>
								</Texture>
							</Layer>
							<Layer level="ARTWORK">
								<Texture parentKey="FactionBadge">
									<Size x="72" y="84"/>
									<Anchors>
										<Anchor point="CENTER"/>
									</Anchors>
								</Texture>
							</Layer>
						</Layers>
						<Frames>
							<Button parentKey="NextRewardLevel" scale="1.1" inherits="PVPHonorRewardTemplate" mixin="InspectRewardBadgeMixin" hidden="true">
								<Anchors>
									<Anchor point="BOTTOM" x="0" y="-1"/>
								</Anchors>
							</Button>
						</Frames>
						<SwipeTexture file="Interface\PVPFrame\pvpqueue-sidebar-honorbar-fill"/>
						<Scripts>
							<OnLoad method="OnLoad"/>
						</Scripts>
					</Cooldown>
				</Frames>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnEvent method="OnEvent"/>
		</Scripts>
	</Frame>
</Ui>
