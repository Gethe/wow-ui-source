						<Anchor point="TOPLEFT" x="5" y="-4"/>
						<Anchor point="TOPRIGHT" x="-80" y="-4"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Label" inherits="GameFontHighlightLarge">
