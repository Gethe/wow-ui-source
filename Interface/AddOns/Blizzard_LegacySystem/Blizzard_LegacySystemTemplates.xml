						<Anchor point="TOPLEFT" relativeKey="$parent.TitleBar" relativePoint="TOPLEFT" x="70" y="-18"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Description" inherits="SystemFont_Shadow_Med1" justifyH="LEFT" justifyV="TOP">
					<!-- Re-anchored by UpdatePlusMinusTexture based on presence of the PlusMinus texture. -->
