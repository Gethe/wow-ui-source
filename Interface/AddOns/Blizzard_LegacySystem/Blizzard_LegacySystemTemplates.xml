			</Button>
			<CheckButton parentKey="Tracked" hidden="true" inherits="LegacyChallengeTrackedTemplate" frameLevel="10">
				<Anchors>
					<Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="-8" y="-8"/>
				</Anchors>
			</CheckButton>
		</Frames>
	</EventButton>

</Ui>
