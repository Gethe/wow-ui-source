						<Anchor point="TOPLEFT" relativeKey="$parent.TitleBar" relativePoint="BOTTOMLEFT" x="72" y="-2"/>
					</Anchors>
				</FontString>
				<FontString parentKey="HiddenDescription" inherits="SystemFont_Shadow_Med1" justifyH="LEFT" justifyV="TOP" hidden="true">
					<!-- Re-anchored by UpdatePlusMinusTexture based on presence of the PlusMinus texture. -->
