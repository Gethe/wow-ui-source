					<Anchors>
						<Anchor point="TOPLEFT" x="76" y="-49"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
		<Frames>
			<Frame parentKey="Icon" inherits="LegacyChallengeIconFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="12" y="-18"/>
				</Anchors>
			</Frame>
			<Button parentKey="Shield" mixin="LegacyChallengeShieldMixin">
				<KeyValues>
					<KeyValue key="smartNavigationIgnored" value="true" type="boolean"/>
				</KeyValues>
				<Size x="64" y="64"/>
				<Anchors>
					<Anchor point="TOPRIGHT" x="-6" y="-2"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture parentKey="Icon" atlas="Legacy-Tree-Frame-Points-Icon" useAtlasSize="true" scale="0.7">
							<Anchors>
								<Anchor point="TOPRIGHT" x="-8" y="-24"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<FontString parentKey="Points" inherits="GameFontNormalMed3" justifyH="CENTER">
							<Anchors>
								<Anchor point="CENTER" relativeKey="$parent.Icon" y="-4"/>
							</Anchors>
						</FontString>
						<Texture parentKey="CheckBackground" atlas="Legacy-Challenge-Cards-Date-BG" useAtlasSize="true">
							<Anchors>
								<Anchor point="TOPRIGHT" x="0" y="-1"/>
							</Anchors>
						</Texture>
						<Texture parentKey="Check" atlas="worldquest-tracker-checkmark" useAtlasSize="true" scale="0.5">
							<Anchors>
								<Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="-4" y="-4"/>
							</Anchors>
						</Texture>
						<FontString parentKey="DateCompleted" inherits="GameFontNormal" hidden="true">
