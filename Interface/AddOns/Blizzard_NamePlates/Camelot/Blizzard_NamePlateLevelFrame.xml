<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<Frame name="NameplateLevelFrame" mixin="NameplateLevelFrameMixin" frameLevel="50" virtual="true">
		<Anchors>
			<Anchor point="LEFT" relativeKey="$parent.HealthBarsContainer" relativePoint="RIGHT" x="5"/>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="playerLevelDiffIcon" atlas="ui-hud-nameplates-levelindicator">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="playerLevelDiffText" inherits="SystemFont_NamePlateLevel"/>
				<Texture parentKey="selectedBorder" atlas="ui-hud-nameplates-levelindicator-rectangle-selected" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="-3" y="4"/>
						<Anchor point="BOTTOMRIGHT" x="3" y="-4"/>
					</Anchors>
				</Texture>
				<Texture parentKey="highLevelTexture" atlas="ui-hud-nameplates-levelindicator-skull">
					<Size x="18" y="18" />
					<Anchors>
						<Anchor point="CENTER" relativePoint="CENTER" relativeKey="$parent.playerLevelDiffIcon"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>
</Ui>
