<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\Blizzard_SharedXML\UI.xsd">

	<Frame name="NameplateLevelFrame" mixin="NameplateLevelFrameMixin" frameStrata="HIGH" virtual="true">
		<Anchors>
			<Anchor point="RIGHT" relativeKey="$parent.HealthBarsContainer" relativePoint="LEFT"/>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="playerLevelDiffIcon" atlas="plunderstorm-nameplates-icon-ring">
					<Anchors>
						<Anchor point="TOPLEFT" x="-1" y="1"/>
						<Anchor point="BOTTOMRIGHT" x="1" y="-1"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="playerLevelDiffText" inherits="GameFontWhiteTiny2">
					<Anchors>
						<Anchor point="CENTER" relativePoint="CENTER" x="1" relativeKey="$parent.playerLevelDiffIcon"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
</Ui>
