<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\..\..\WoW\Data\Interface\AddOns\Blizzard_SharedXML\UI.xsd">

	<Button name="CharacterSheetLineTemplate" mixin="CharacterSheetLineMixin" virtual="true">
		<Size x="400" y="30"/>
		<Layers>
			<Layer level="BORDER">
				<FontString parentKey="Name" inherits="GameFontHighlight" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" x="62"/>
					</Anchors>
				</FontString>

				<FontString parentKey="Value" inherits="GameFontHighlight" justifyH="RIGHT">
					<Anchors>
						<Anchor point="RIGHT" x="-62"/>
					</Anchors>
				</FontString>

				<Texture parentKey="Background" atlas="UI-Character-Info-Line-Bounce-Talebound" alpha="0.5" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<Frame name="CharacterSheetListTemplate" mixin="CharacterSheetListMixin" virtual="true">
		<Size x="400" y="1"/>
		<Frames>
			<Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
				<Anchors>
					<Anchor point="TOPLEFT"/>
					<Anchor point="BOTTOMRIGHT"/>
				</Anchors>
			</Frame>
			<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
				<Anchors>
					<Anchor point="TOPRIGHT" x="-42" y="0"/>
					<Anchor point="BOTTOMRIGHT" x="-42" y="0"/>
				</Anchors>
			</EventFrame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
		</Scripts>
	</Frame>

</Ui>
