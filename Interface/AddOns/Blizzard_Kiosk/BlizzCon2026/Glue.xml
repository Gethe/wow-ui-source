<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">
	<Frame name="KioskFrame" inherits="KioskFrameTemplate" mixin="GlueKioskFrameMixin">
		<Scripts>
			<OnEvent method="OnEvent"/>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>

	<Button name="KioskExperienceButton" mixin="GlueKioskExperienceButtonMixin" virtual="true">
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Background" setAllPoints="true" nonBlocking="false"/>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Text" inherits="Game40Font_Shadow2" justifyH="CENTER" justifyV="MIDDLE">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<Color color="NORMAL_FONT_COLOR"/>
				</FontString>
				<Texture parentKey="Highlight" setAllPoints="true" atlas="Kiosk-Mode-button-glow-c60" nonBlocking="false" hidden="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnEnable method="OnEnable"/>
			<OnDisable method="OnDisable"/>
		</Scripts>
	</Button>
	
	<Frame name="KioskModeSplash" mixin="GlueKioskModeSplashMixin" enableMouse="true" toplevel="true" setAllPoints="true" hidden="true">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" setAllPoints="true" nonBlocking="false"/>
			</Layer>
		</Layers>
		<Frames>
			<Button parentKey="StarterButton" scale=".7" inherits="KioskExperienceButton">
				<Size x="1089" y="280"/>
				<Anchors>
					<Anchor point="RIGHT" relativePoint="BOTTOM" x="-20" y="250"/>
				</Anchors>
			</Button>
			<Button parentKey="DungeonButton" scale=".7" inherits="KioskExperienceButton">
				<Size x="1089" y="280"/>
				<Anchors>
					<Anchor point="LEFT" relativePoint="BOTTOM" x="20" y="250"/>
				</Anchors>
			</Button>
			<Frame parentKey="Spinner" inherits="SpinnerWithShadowTemplate" hidden="true">
				<Size x="30" y="30"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="40" y="40"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnUpdate method="OnUpdate"/>
		</Scripts>
	</Frame>
</Ui>
