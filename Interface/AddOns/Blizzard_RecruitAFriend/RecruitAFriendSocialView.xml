<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\Blizzard_SharedXML\UI.xsd">

	<Button name="RAFClaimRewardButtonSocialViewBaseTemplate" mixin="RecruitAFriendClaimRewardButtonBaseMixin" virtual="true">
		<Frames>
			<Frame parentKey="YellowGlow" alpha="0">
				<Size x="1" y="1"/>
				<Anchors>
					<Anchor point="LEFT"/>
					<Anchor point="RIGHT"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture parentKey="Left" atlas="newplayertutorial-yellowGlow-redbutton-left" useAtlasSize="true" alphaMode="ADD">
							<Anchors>
								<Anchor point="LEFT"/>
							</Anchors>
						</Texture>
						<Texture parentKey="Right" atlas="newplayertutorial-yellowGlow-redbutton-right" useAtlasSize="true" alphaMode="ADD">
							<Anchors>
								<Anchor point="RIGHT"/>
							</Anchors>
						</Texture>
						<Texture parentKey="Middle" atlas="newplayertutorial-yellowGlow-redbutton-middle" alphaMode="ADD">
							<Anchors>
								<Anchor point="TOPLEFT" relativeKey="$parent.Left" relativePoint="TOPRIGHT"/>
								<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Right" relativePoint="BOTTOMLEFT"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Animations>
			<AnimationGroup parentKey="UnclaimedRewardsAnim" looping="REPEAT" setToFinalAlpha="true">
				<Alpha childKey="YellowGlow" duration="1" order="1" fromAlpha="0" toAlpha="0.6" />
				<Alpha childKey="YellowGlow" duration="1" order="2" fromAlpha="0.6" toAlpha="0" />
			</AnimationGroup>
		</Animations>
		<Scripts>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnHide method="OnHide"/>
		</Scripts>
	</Button>

	<Frame name="RewardClaimingSocialTemplate" inherits="UserScaledFrameTemplate" virtual="true" mixin="RewardClaimingMixin">
		<KeyValues>
			<KeyValue key="legacyBackgroundAtlas" value="friends-RAF-headerBG" type="string"/>
			<KeyValue key="backgroundAtlas" value="friends-RAF-headerBG" type="string"/>

			<KeyValue key="baseHeight" value="125" type="number"/>
			<KeyValue key="useScaleWeight" value="true" type="boolean"/>
			<KeyValue key="useScaleWeightForHeight" value="true" type="boolean"/>
			<KeyValue key="scaleWeight" value="0.5" type="number"/>
		</KeyValues>
		<Layers>
			<Layer level="BACKGROUND" textureSubLevel="0">
				<Texture parentKey="Background" atlas="friends-RAF-headerBG" useAtlasSize="false" setAllPoints="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Watermark" atlas="recruitafriend_v3_iwatermark_big" useAtlasSize="true" alpha="0.2" scale="1.15">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Background" x="-11" y="11"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="MonthCount" inherits="TruncatedTooltipScriptTemplate, UserScaledFrameByHeightTemplate">
				<Size x="285"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Background" x="115" y="-18"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Text" inherits="UserScaledFontGameNormalLarge" maxLines="1" justifyH="LEFT">
							<KeyValues>
								<KeyValue key="heightContributing" value="true" type="boolean"/>
							</KeyValues>
							<Size x="285"/>
						</FontString>
					</Layer>
				</Layers>
			</Frame>

			<Frame parentKey="EarnInfo" inherits="TruncatedTooltipScriptTemplate, UserScaledFrameByHeightTemplate">
				<Size x="285"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.MonthCount" relativePoint="BOTTOMLEFT" y="-6"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Text" inherits="UserScaledFontGameHighlight" maxLines="1" justifyH="LEFT">
							<KeyValues>
								<KeyValue key="heightContributing" value="true" type="boolean"/>
							</KeyValues>
							<Size x="285"/>
						</FontString>
					</Layer>
				</Layers>
			</Frame>

			<Frame parentKey="NextRewardName" inherits="TruncatedTooltipScriptTemplate, UserScaledFrameByHeightTemplate">
				<Size x="285"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.EarnInfo" relativePoint="BOTTOMLEFT" y="-4"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Text" inherits="UserScaledFontGameNormalLarge" maxLines="1" justifyH="LEFT">
							<KeyValues>
								<KeyValue key="heightContributing" value="true" type="boolean"/>
							</KeyValues>
							<Size x="285"/>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
			
			<Button parentKey="NextRewardButton" inherits="RecruitAFriendRewardButtonTemplate" mixin="RecruitAFriendRewardButtonWithFanfareMixin">
				<KeyValues>
					<KeyValue key="Icon_RingClaimed" value="friends-RAF-circFrame" type="string"/>
					<KeyValue key="Icon_RingUnclaimed" value="friends-RAF-circFrame" type="string"/>
				</KeyValues>
				<Size x="66" y="66"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.Background" relativePoint="LEFT" x="30" />
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture parentKey="ClaimGlow" atlas="services-ring-large-glow" alpha="0" ignoreParentAlpha="true" useAtlasSize="true" scale="0.54">
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
						<Texture parentKey="ClaimGlowSpin" atlas="services-ring-large-glowspin" alpha="0" ignoreParentAlpha="true" alphaMode="ADD" useAtlasSize="true" scale="0.675">
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="ARTWORK">
						<MaskTexture parentKey="CircleMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE" setAllPoints="true">
							<MaskedTextures>
								<MaskedTexture childKey="Icon"/>
								<MaskedTexture childKey="IconOverlay"/>
							</MaskedTextures>
						</MaskTexture>
					</Layer>
					<Layer level="OVERLAY" textureSubLevel="3">
						<Texture parentKey="IconBorder" atlas="friends-RAF-circFrame">
							<Size x="86" y="86"/>
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="OVERLAY" textureSubLevel="4">
						<Texture parentKey="ClaimFlash" atlas="azsharawards-fullglow" useAtlasSize="true" ignoreParentAlpha="true" alphaMode="ADD" alpha="0">
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
						<Texture parentKey="ClaimFlashStar" atlas="azsharawards-starglow" useAtlasSize="true" ignoreParentAlpha="true" alphaMode="ADD" alpha="0">
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
				<Frames>
					<ModelScene parentKey="ModelScene" inherits="NonInteractableWrappedModelSceneTemplate" frameStrata="HIGH" hidden="true">
						<Size x="169" y="169"/>
						<Anchors>
							<Anchor point="CENTER" relativePoint="BOTTOMRIGHT"/>
						</Anchors>
					</ModelScene>
				</Frames>
				<Animations>
					<AnimationGroup parentKey="ClaimGlowSpinAnim" looping="REPEAT">
						<Rotation childKey="ClaimGlowSpin" degrees="-360" duration="15"/>
					</AnimationGroup>
					<AnimationGroup parentKey="ClaimGlowInAnim" setToFinalAlpha="true">
						<Alpha childKey="ClaimGlow" fromAlpha="0" toAlpha="0.8" duration=".4"/>
						<Alpha childKey="ClaimGlowSpin" fromAlpha="0" toAlpha="0.3" duration=".4"/>
					</AnimationGroup>
					<AnimationGroup parentKey="ClaimGlowOutAnim" setToFinalAlpha="true">
						<Alpha childKey="ClaimGlow" fromAlpha="0.8" toAlpha="0" duration=".4"/>
						<Alpha childKey="ClaimGlowSpin" fromAlpha="0.3" toAlpha="0" duration=".4"/>
					</AnimationGroup>
					<AnimationGroup parentKey="ClaimFlashAnim" setToFinalAlpha="true">
						<Alpha childKey="ClaimFlash" fromAlpha="0" toAlpha="1" order="0" duration=".4"/>
						<Alpha childKey="ClaimFlash" fromAlpha="1" toAlpha="0" order="1" duration=".4"/>
						<Alpha childKey="ClaimFlashStar" fromAlpha="0" toAlpha="1" order="0" duration=".4"/>
						<Alpha childKey="ClaimFlashStar" fromAlpha="1" toAlpha="0" order="1" duration=".4"/>
					</AnimationGroup>
				</Animations>
				<Scripts>
					<OnLoad method="OnLoad" />
				</Scripts>
			</Button>
			<Button parentKey="ClaimOrViewRewardButton" inherits="SocialUIActionButtonTemplate, RAFClaimRewardButtonSocialViewBaseTemplate" motionScriptsWhileDisabled="true" mixin="RecruitAFriendSocialViewClaimOrViewRewardButtonMixin" scale="0.9">
				<KeyValues>
					<KeyValue key="baseWidth" value="170" type="number"/>
					<KeyValue key="maxWidth" value="230" type="number"/>

					<KeyValue key="useScaleWeight" value="true" type="boolean"/>
					<KeyValue key="useScaleWeightForHeight" value="true" type="boolean"/>
					<KeyValue key="scaleWeight" value="0.4" type="number"/>

					<KeyValue key="bottomAnchorYOffset" value="16" type="number"/>
				</KeyValues>
				<Scripts>
					<OnLoad method="OnLoad" />
					<OnClick method="OnClick" />
				</Scripts>
			</Button>
		</Frames>
	</Frame>

	<Button name="RecruitActivityButtonSocialTemplate" inherits="RecruitActivityButtonTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="Icon_TrialAccount" value="friends-RAF-chest-locked" type="string"/>
			<KeyValue key="Icon_CursorOverChecked" value="friends-RAF-chest-claimed-hover" type="string"/>
			<KeyValue key="Icon_CursorOver" value="friends-RAF-chest-default-hover" type="string"/>
			<KeyValue key="Icon_CursorOverOpen" value="friends-RAF-chest-ready-hover" type="string"/>
			<KeyValue key="Icon_ActiveChest" value="friends-raf-chest-default" type="string"/>
			<KeyValue key="Icon_OpenChest" value="friends-raf-chest-ready" type="string"/>
			<KeyValue key="Icon_ClaimedChest" value="friends-RAF-chest-claimed" type="string"/>
		</KeyValues>
	</Button>
	
	<Button name="RecruitListButtonSocialTemplate" registerForClicks="LeftButtonUp, RightButtonUp" virtual="true" mixin="RecruitListButtonSocialMixin">
		<KeyValues>
			<KeyValue key="dynamicBackground" value="false" type="boolean"/>

			<KeyValue key="baseHeight" value="70" type="number"/>
			<KeyValue key="useScaleWeightForHeight" value="true" type="boolean"/>
			<KeyValue key="scaleWeight" value="0.6" type="number"/>

			<KeyValue key="presenceHolderXOffset" value="3" type="number"/>
			<KeyValue key="presenceHolderYOffset" value="-4" type="number"/>

			<KeyValue key="textHolderTopLeftXOffset" value="-4" type="number"/>
			<KeyValue key="textHolderTopLeftYOffset" value="3" type="number"/>
			<KeyValue key="textHolderRightXOffset" value="-8" type="number"/>
			<KeyValue key="textHolderBottomYOffset" value="5" type="number"/>

			<!-- Vertical spacing between the card's text lines -->
			<KeyValue key="lineSpacing" value="4" type="number"/>
		</KeyValues>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" atlas="friends-card-default" setAllPoints="true"/>
				<Texture parentKey="Icon"/>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Name" inherits="UserScaledFontHeader" justifyH="LEFT" justifyV="MIDDLE" maxLines="1" wordwrap="false">
					<!-- Anchored dynamically in LayoutCardDisplayText -->
				</FontString>
				<FontString parentKey="CharacterName" inherits="UserScaledFontBody" justifyH="LEFT" justifyV="MIDDLE" maxLines="1" wordwrap="false">
					<!-- Anchored dynamically in LayoutCardDisplayText -->
				</FontString>
				<FontString parentKey="InfoText" inherits="UserScaledFontBody" justifyH="LEFT" justifyV="MIDDLE" maxLines="1" wordwrap="false">
					<!-- Anchored dynamically in LayoutCardDisplayText -->
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="PresenceHolder" inherits="SocialCardPresenceHolderTemplate">
				<!-- Anchored dynamically in LayoutScaledPresenceHolderAnchors -->
			</Frame>
			<Frame parentKey="TextHolder">
				<!-- Anchored dynamically in LayoutScaledTextHolderAnchors -->
			</Frame>
			<Button parentArray="Activities" inherits="RecruitActivityButtonSocialTemplate">
				<Anchors>
					<Anchor point="RIGHT" x="-112"/>
				</Anchors>
			</Button>
			<Button parentArray="Activities" inherits="RecruitActivityButtonSocialTemplate">
				<Anchors>
					<Anchor point="RIGHT" x="-63"/>
				</Anchors>
			</Button>
			<Button parentArray="Activities" inherits="RecruitActivityButtonSocialTemplate">
				<Anchors>
					<Anchor point="RIGHT" x="-14"/>
				</Anchors>
			</Button>
		</Frames>
		<Scripts>
			<OnEnter method="OnEnter" />
			<OnLeave method="OnLeave" />
			<OnClick method="OnClick" />
		</Scripts>
		<HighlightTexture atlas="friends-card-selected" alphaMode="ADD" setAllPoints="true" />
	</Button>
	
	<Frame name="RecruitAFriendFrameSocialViewTemplate" mixin="RecruitAFriendFrameSocialViewMixin" virtual="true" inherits="SocialUIContactsFrameTemplate, CallbackRegistrantTemplate">
		<KeyValues>
			<KeyValue key="fractionString" value="GENERIC_FRACTION_STRING" type="global"/>
			<KeyValue key="scrollContentsTemplate" value="RecruitListButtonSocialTemplate" type="string"/>
		</KeyValues>
		<Frames>
			<Frame parentKey="RewardClaiming" inherits="RewardClaimingSocialTemplate" useParentLevel="true">
				<Size y="120"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="2" y="5"/>
					<Anchor point="TOPRIGHT" x="2" y="5"/>
				</Anchors>
			</Frame>
			<Frame parentKey="NoRecruitsScrollBox" inherits="WowScrollBox">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" x="23" y="-10"/>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBox" x="-23"/>
				</Anchors>
				<Frames>
					<SimpleHTML parentKey="NoRecruitsDesc" resizeToFitContents="true">
						<KeyValues>
							<KeyValue key="scrollable" value="true" type="boolean"/>
						</KeyValues>
						<Size x="334"/>
						<Scripts>
							<OnHyperlinkClick function="GetURLIndexAndLoadURL" />
						</Scripts>
						<FontString inherits="UserScaledFontGameHighlightLarge" justifyH="CENTER" />
					</SimpleHTML>
				</Frames>
			</Frame>
			<EventFrame parentKey="NoRecruitsScrollBar" inherits="MinimalScrollBar">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="5" y="-7"/>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT" x="5" y="4"/>
				</Anchors>
			</EventFrame>
		</Frames>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Header" inherits="UserScaledFontBody" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.RewardClaiming" relativePoint="BOTTOMLEFT" x="11" y="-16"/>
					</Anchors>
					<Color color="GRAY_FONT_COLOR"/>
				</FontString>
				<FontString parentKey="Count" inherits="UserScaledFontBody" justifyH="RIGHT">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Header" relativePoint="RIGHT" x="5"/>
					</Anchors>
					<Color color="GRAY_FONT_COLOR"/>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent" />
			<OnHide method="OnHide" />
			<OnShow method="OnShow"/>
		</Scripts>
	</Frame>
</Ui>
