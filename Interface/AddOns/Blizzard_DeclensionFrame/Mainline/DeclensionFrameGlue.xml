<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">
	<Frame name="DeclensionTemplate"  virtual="true">
		<Size x="300" y="40"/>
		<Layers>
			<Layer level="BACKGROUND">
				<FontString name="$parentType" inherits="GlueFontNormal">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset x="0" y="0"/>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentExample" inherits="GlueFontHighlightExtraSmall">
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentType" relativePoint="BOTTOMLEFT">
							<Offset x="0" y="0"/>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<EditBox name="$parentEdit" inherits="TooltipBackdropTemplate" letters="16">
				<KeyValues>
					<KeyValue key="layoutType" value="TooltipMixedLayout" type="string"/>
					<KeyValue key="backdropColor" value="GLUE_BACKDROP_COLOR" type="global"/>
					<KeyValue key="backdropBorderColor" value="GLUE_BACKDROP_BORDER_COLOR" type="global"/>
				</KeyValues>
				<Size x="160" y="37"/>
				<Anchors>
					<Anchor point="LEFT">
						<Offset x="250" y="2"/>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnEscapePressed>
						DeclensionFrame_OnCancel();
					</OnEscapePressed>
					<OnEnterPressed>
						DeclensionFrame_OnOkay();
					</OnEnterPressed>
					<OnTabPressed>
						EditBox_HandleTabbing(self, RUSSIAN_DECLENSION_TAB_LIST);
					</OnTabPressed>
					<OnEditFocusLost>
						self:HighlightText(0, 0);
					</OnEditFocusLost>
					<OnEditFocusGained>
						self:HighlightText();
					</OnEditFocusGained>
					<OnTextChanged>
						_G[self:GetParent():GetName().."Example"]:SetText(format(_G["RUSSIAN_DECLENSION_EXAMPLE_"..self:GetParent():GetID()], self:GetText()));
					</OnTextChanged>
				</Scripts>
				<FontString inherits="GlueEditBoxFont"/>
				<TextInsets>
					<AbsInset left="10" bottom="3"/>
				</TextInsets>
			</EditBox>
		</Frames>
	</Frame>
	<Frame name="DeclensionFrame" inherits="BackdropTemplate" toplevel="true" parent="GlueParent" movable="false" enableMouse="true" hidden="true">
		<KeyValues>
			<KeyValue key="backdropInfo" value="BACKDROP_DIALOG_32_32" type="global"/>
		</KeyValues>
		<Size x="450" y="330"/>
		<Anchors>
			<Anchor point="CENTER">
				<Offset x="0" y="0"/>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="$parentNominative" inherits="GlueFontNormalHuge">
					<Anchors>
						<Anchor point="TOP">
							<Offset x="0" y="-16"/>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString inherits="GlueFontHighlightSmall" text="RUSSIAN_DECLENSION">
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentNominative">
							<Offset x="0" y="-16"/>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentBlockOut" enableMouse="true">
				<Layers>
					<Layer level="BACKGROUND">
						<Texture setAllPoints="true">
							<Color a="0.75" r="0" g="0" b="0"/>
						</Texture>
					</Layer>
				</Layers>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="GlueParent" />
					<Anchor point="BOTTOMRIGHT" relativeTo="GlueParent" />
				</Anchors>
			</Frame>
			<Frame name="$parentDeclension1" inherits="DeclensionTemplate" id="1">
				<Size x="300" y="40"/>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset x="20" y="-64"/>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="$parentDeclension2" inherits="DeclensionTemplate" id="2">
				<Size x="300" y="40"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentDeclension1" relativePoint="BOTTOMLEFT">
						<Offset x="0" y="0"/>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="$parentDeclension3" inherits="DeclensionTemplate" id="3">
				<Size x="300" y="40"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentDeclension2" relativePoint="BOTTOMLEFT">
						<Offset x="0" y="0"/>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="$parentDeclension4" inherits="DeclensionTemplate" id="4">
				<Size x="300" y="40"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentDeclension3" relativePoint="BOTTOMLEFT">
						<Offset x="0" y="0"/>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="$parentDeclension5" inherits="DeclensionTemplate" id="5">
				<Size x="300" y="40"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentDeclension4" relativePoint="BOTTOMLEFT">
						<Offset x="0" y="0"/>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="$parentSet">
				<Size x="150" y="24"/>
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset x="0" y="50"/>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<FontString name="$parentPage" inherits="GlueFontNormalSmall" text="1 of 2">
							<Size>
								<AbsDimension x="50" y="16"/>
							</Size>
							<Anchors>
								<Anchor point="CENTER">
									<Offset x="0" y="0"/>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Button name="$parentNext">
						<Size>
							<AbsDimension x="20" y="20"/>
						</Size>
						<Anchors>
							<Anchor point="LEFT" relativeTo="$parentPage" relativePoint="RIGHT">
								<Offset x="10" y="0"/>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnClick>
								DeclensionFrame_Next();
								PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON);
							</OnClick>
						</Scripts>
						<NormalTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Up"/>
						<PushedTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Down"/>
						<DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Disabled"/>
						<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
						<PushedTextOffset>
							<AbsDimension x="0" y="0"/>
						</PushedTextOffset>
					</Button>
					<Button name="$parentPrev">
						<Size>
							<AbsDimension x="20" y="20"/>
						</Size>
						<Anchors>
							<Anchor point="RIGHT" relativeTo="$parentPage" relativePoint="LEFT">
								<Offset x="-10" y="0"/>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnClick>
								DeclensionFrame_Prev();
								PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON);
							</OnClick>
						</Scripts>
						<NormalTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Up"/>
						<PushedTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Down"/>
						<DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Disabled"/>
						<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
						<PushedTextOffset>
							<AbsDimension x="0" y="0"/>
						</PushedTextOffset>
					</Button>
				</Frames>
			</Frame>
			<Button name="$parentOkayButton" inherits="GlueButtonSmallTemplate" text="OKAY">
				<Anchors>
					<Anchor point="RIGHT" relativePoint="BOTTOM">
						<Offset x="10" y="32"/>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						DeclensionFrame_OnOkay();
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentCancelButton" inherits="GlueButtonSmallTemplate" text="CANCEL">
				<Anchors>
					<Anchor point="LEFT" relativePoint="BOTTOM">
						<Offset x="10" y="32"/>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						DeclensionFrame_OnCancel();
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnShow>
				local frameLevel = DeclensionFrame:GetFrameLevel();
				DeclensionFrameBlockOut:SetFrameLevel(frameLevel);
				DeclensionFrame:SetFrameLevel(frameLevel + 2);
				DeclensionFrame_Update();
			</OnShow>
			<OnEvent>
				DeclensionFrame_OnEvent(self, event, ...);
			</OnEvent>
			<OnLoad>
				DeclensionFrame_OnLoad(self);
			</OnLoad>
		</Scripts>
	</Frame>
</Ui>
