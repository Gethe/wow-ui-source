<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">
	<Frame name="DeclensionTemplate"  virtual="true">
		<Size x="300" y="40"/>
		<Layers>
			<Layer level="BACKGROUND">
				<FontString name="$parentType" inherits="GameFontNormalLarge">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset x="0" y="0"/>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentExample" inherits="GameFontHighlight">
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentType" relativePoint="BOTTOMLEFT">
							<Offset x="0" y="0"/>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<EditBox name="$parentEdit" inherits="TooltipBackdropTemplate" letters="16">
				<KeyValues>
					<KeyValue key="layoutType" value="TooltipMixedLayout" type="string"/>
					<KeyValue key="backdropColor" value="DECLENSION_BACKDROP_COLOR" type="global"/>
					<KeyValue key="backdropBorderColor" value="DECLENSION_BACKDROP_BORDER_COLOR" type="global"/>
				</KeyValues>
				<Size x="160" y="30"/>
				<Anchors>
					<Anchor point="LEFT">
						<Offset x="250" y="2"/>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnEscapePressed>
						DeclensionFrame_OnCancel();
					</OnEscapePressed>
					<OnEnterPressed>
						DeclensionFrame_OnOkay();
					</OnEnterPressed>
					<OnTabPressed>
						EditBox_HandleTabbing(self, RUSSIAN_DECLENSION_TAB_LIST);
					</OnTabPressed>
					<OnEditFocusLost>
						self:HighlightText(0, 0);
					</OnEditFocusLost>
					<OnEditFocusGained>
						self:HighlightText();
					</OnEditFocusGained>
					<OnTextChanged>
						_G[self:GetParent():GetName().."Example"]:SetText(format(_G["RUSSIAN_DECLENSION_EXAMPLE_"..self:GetParent():GetID()], self:GetText()));
					</OnTextChanged>
				</Scripts>
				<FontString inherits="NumberFontNormalLarge"/>
				<TextInsets>
					<AbsInset left="10" bottom="2"/>
				</TextInsets>
			</EditBox>
		</Frames>
	</Frame>
	<Frame name="DeclensionFrame" inherits="BackdropTemplate" toplevel="true" parent="UIParent" movable="false" enableMouse="true" hidden="true">
		<KeyValues>
			<KeyValue key="backdropInfo" value="BACKDROP_DIALOG_32_32" type="global"/>
		</KeyValues>
		<Size x="450" y="330"/>
		<Anchors>
			<Anchor point="CENTER">
				<Offset x="0" y="0"/>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="$parentNominative" inherits="BossEmoteNormalHuge">
					<Anchors>
						<Anchor point="TOP">
							<Offset x="0" y="-16"/>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString inherits="GameFontHighlight" text="RUSSIAN_DECLENSION">
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentNominative">
							<Offset x="0" y="-16"/>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentDeclension1" inherits="DeclensionTemplate" id="1">
				<Size x="300" y="40"/>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset x="20" y="-64"/>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="$parentDeclension2" inherits="DeclensionTemplate" id="2">
				<Size x="300" y="40"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentDeclension1" relativePoint="BOTTOMLEFT">
						<Offset x="0" y="0"/>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="$parentDeclension3" inherits="DeclensionTemplate" id="3">
				<Size x="300" y="40"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentDeclension2" relativePoint="BOTTOMLEFT">
						<Offset x="0" y="0"/>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="$parentDeclension4" inherits="DeclensionTemplate" id="4">
				<Size x="300" y="40"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentDeclension3" relativePoint="BOTTOMLEFT">
						<Offset x="0" y="0"/>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="$parentDeclension5" inherits="DeclensionTemplate" id="5">
				<Size x="300" y="40"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentDeclension4" relativePoint="BOTTOMLEFT">
						<Offset x="0" y="0"/>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="$parentSet">
				<Size x="150" y="24"/>
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset x="0" y="50"/>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<FontString name="$parentPage" inherits="GameFontNormalSmall" text="1 of 2">
							<Size>
								<AbsDimension x="40" y="16"/>
							</Size>
							<Anchors>
								<Anchor point="CENTER">
									<Offset x="0" y="0"/>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Button name="$parentNext">
						<Size>
							<AbsDimension x="20" y="20"/>
						</Size>
						<Anchors>
							<Anchor point="LEFT" relativeTo="$parentPage" relativePoint="RIGHT">
								<Offset x="10" y="0"/>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnClick>
								DeclensionFrame_Next();
								PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON);
							</OnClick>
						</Scripts>
						<NormalTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Up"/>
						<PushedTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Down"/>
						<DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Disabled"/>
						<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
						<PushedTextOffset>
							<AbsDimension x="0" y="0"/>
						</PushedTextOffset>
					</Button>
					<Button name="$parentPrev">
						<Size>
							<AbsDimension x="20" y="20"/>
						</Size>
						<Anchors>
							<Anchor point="RIGHT" relativeTo="$parentPage" relativePoint="LEFT">
								<Offset x="-10" y="0"/>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnClick>
								DeclensionFrame_Prev();
								PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON);
							</OnClick>
						</Scripts>
						<NormalTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Up"/>
						<PushedTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Down"/>
						<DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Disabled"/>
						<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
						<PushedTextOffset>
							<AbsDimension x="0" y="0"/>
						</PushedTextOffset>
					</Button>
				</Frames>
			</Frame>
			<Button name="$parentOkayButton" inherits="UIPanelButtonTemplate" text="OKAY">
				<Anchors>
					<Anchor point="RIGHT" relativePoint="BOTTOM">
						<Offset x="-3" y="32"/>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						DeclensionFrame_OnOkay();
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentCancelButton" inherits="UIPanelButtonTemplate" text="CANCEL">
				<Size x="60" y="22"/>
				<Anchors>
					<Anchor point="LEFT" relativePoint="BOTTOM">
						<Offset x="3" y="32"/>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						DeclensionFrame_OnCancel();
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
      <OnLoad>
      	BackdropTemplateMixin.OnBackdropLoaded(self);
        self:RegisterEvent("PET_FORCE_NAME_DECLENSION");
		self:RegisterEvent("BATTLEPET_FORCE_NAME_DECLENSION");
        self.set = 1;
      </OnLoad>
      <OnEvent>
        DeclensionFrame_OnEvent(self, event, ...);
      </OnEvent>
      <OnShow>
        DeclensionFrame_Update();
      </OnShow>
		</Scripts>
	</Frame>
</Ui>
