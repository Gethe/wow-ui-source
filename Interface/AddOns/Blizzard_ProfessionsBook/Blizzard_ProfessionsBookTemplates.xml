<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\..\..\WoW\Data\Interface\AddOns\Blizzard_SharedXML\UI.xsd">

	<CheckButton name="ProfessionButtonTemplate" inherits="SecureFrameTemplate, FlyoutButtonTemplate" mixin="ProfessionSpellButtonMixin" virtual="true">
		<KeyValues>
			<KeyValue key="popupDirection" value="RIGHT" type="string"/>
			<KeyValue key="popupOffset" value="-4" type="number"/>
			<KeyValue key="popupCrossAxisSize" value="42" type="number"/>
			<KeyValue key="openArrowOffset" value="2" type="number"/>
			<KeyValue key="closedArrowOffset" value="4" type="number"/>
			<KeyValue key="buttonContext" value="ButtonContext_ProfessionsButton" type="string"/>
		</KeyValues>
		<Size x="40" y="40"/>
		<Layers>
			<Layer level="BORDER">
				<Texture setAllPoints="true" parentKey="IconTexture"/>
				<MaskTexture parentKey="OutlineMask" atlas="SquareMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="3" y="-3"/>
						<Anchor point="BOTTOMRIGHT" x="-3" y="3"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="IconTexture"/>
					</MaskedTextures>
				</MaskTexture>
				<FontString inherits="GameFontNormal" maxLines="2" justifyH="LEFT" parentKey="spellString">
					<Size x="100" y="0"/>
					<Anchors>
						<Anchor point="LEFT" relativePoint="RIGHT" x="5" y="7"/>
					</Anchors>
				</FontString>
				<FontString inherits="NewSubSpellFont" justifyH="LEFT" justifyV="TOP" parentKey="subSpellString">
					<Size x="95" y="28"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.spellString" relativePoint="BOTTOMLEFT" x="0" y="-1"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="IconTextureOverlay" hidden="true">
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.IconTexture"/>
					</Anchors>
				</Texture>

				<Texture parentKey="Flash" file="Interface\Buttons\CheckButtonGlow" alphaMode="ADD" hidden="true">
					<Size x="71" y="71"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Cooldown name="$parentCooldown" inherits="CooldownFrameTemplate" parentKey="cooldown"/>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEvent method="OnEvent"/>
			<PreClick>
				self:SetChecked(false);
			</PreClick>
			<OnClick method="OnClick"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnDragStart method="OnDragStart"/>
			<OnDragStop method="OnDragStop"/>
			<OnReceiveDrag method="OnReceiveDrag"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
		<PushedTexture file="Interface\Buttons\UI-Quickslot-Depress"/>
		<HighlightTexture name="$parentHighlight" file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD" parentKey="highlightTexture"/>
		<CheckedTexture file="Interface\Buttons\CheckButtonHilight" alphaMode="ADD"/>
	</CheckButton>
	<Frame name="ProfessionTrialCapTemplate" hidden="true" enableMouse="true" virtual="true">
		<Size x="18" y="21"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentLockedIndicator"  file="Interface/LFGFrame/UI-LFG-ICON-LOCK" parentKey="lockedIndicator" setAllPoints="true">
					<TexCoords left="0" right="0.71875" top="0" bottom="0.875"/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnEnter>
				GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
				GameTooltip:SetText(CAP_REACHED_TRIAL, RED_FONT_COLOR.r, RED_FONT_COLOR.b, RED_FONT_COLOR.b);
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
		</Scripts>
	</Frame>
	<StatusBar name="ProfessionStatusBarTemplate" virtual="true">
		<Size x="95" y="16"/>
		<Layers>
			<Layer level="OVERLAY">
				<FontString inherits="TextStatusBarText" parentKey ="rankText" text="0/0">
					<Anchors>
						<Anchor point="CENTER" x="0" y="2"/>
					</Anchors>
				</FontString>
				<Texture file="Interface\Spellbook\ProfessionsBook" parentKey="capLeft">
					<Size x="12" y="12"/>
					<Anchors>
						<Anchor point="RIGHT" relativeKey="$parent" relativePoint="LEFT"  x="0" y="2"/>
					</Anchors>
					<TexCoords left="0.00390625" right="0.05078125" top="0.87500000" bottom="0.96875000"/>
				</Texture>
				<Texture file="Interface\Spellbook\ProfessionsBook" hidden="true" parentKey="capRight">
					<Size x="12" y="12"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent" relativePoint="RIGHT"  x="0" y="2"/>
					</Anchors>
					<TexCoords left="0.00390625" right="0.05078125" top="0.76562500" bottom="0.85937500"/>
				</Texture>
			</Layer>
			<Layer level="BACKGROUND">
				<Texture parentKey="BGLeft" file="Interface\Spellbook\ProfessionsBook">
					<Anchors>
						<Anchor point="RIGHT" relativePoint="LEFT" y="2"/>
					</Anchors>
					<Size x="16" y="16"/>
					<TexCoords left="0.00390625" right="0.06640625" top="0.48437500" bottom="0.60937500"/>
				</Texture>
				<Texture parentKey="BGRight" file="Interface\Spellbook\ProfessionsBook">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent" relativePoint="RIGHT" y="2"/>
					</Anchors>
					<Size x="16" y="16"/>
					<TexCoords left="0.00390625" right="0.06640625" top="0.62500000" bottom="0.75000000"/>
				</Texture>
				<Texture parentKey="BGMiddle" file="Interface\Spellbook\ProfessionsBook">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.BGLeft" relativePoint="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.BGRight" relativePoint="BOTTOMLEFT"/>
					</Anchors>
					<TexCoords left="0.00000000" right="1.00000000" top="0.00781250" bottom="0.13281250"/>
				</Texture>
			</Layer>
		</Layers>
		<BarTexture parentKey="Bar" file="Interface\Spellbook\Professions-Progress-Fill"/>
		<!--BarColor r="1" g="1" b="1"/-->
		<Frames>
			<Frame parentKey="capped" inherits="ProfessionTrialCapTemplate">
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent" relativePoint="TOPRIGHT" x="14" y="2"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnEnter>
				if ( self.tooltip ) then
				GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
				GameTooltip:SetText(self.tooltip);
				end
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
		</Scripts>
	</StatusBar>

</Ui>
