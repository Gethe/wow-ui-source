					<KeyValue key="smartNavigationIgnored" value="true" type="boolean"/>
				</KeyValues>
				<Size x="20" y="20"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.StatusBar" relativePoint="RIGHT" x="1" y="-4"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture parentKey="Icon" atlas="Profession-button-red-crossmark" useAtlasSize="true">
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<Texture parentKey="Overlay" atlas="Profession-button-red-crossmark-pressed" useAtlasSize="true" hidden="true">
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnter method="OnEnter"/>
					<OnLeave method="OnLeave"/>
					<OnMouseDown method="OnMouseDown"/>
					<OnMouseUp method="OnMouseUp"/>
				</Scripts>
			</Button>
			<Frame parentKey="GamepadUnlearnButton" inherits="InputIconTextureFrameTemplate" hidden="true">
				<KeyValues>
					<KeyValue key="mappedButtonKey" value="GAMEPAD_FACE_LEFT" type="global"/>
					<KeyValue key="useDropShadow" value="true" type="boolean"/>
				</KeyValues>
				<Size x="22" y="22"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.UnlearnButton" relativePoint="RIGHT" x="3" y="2"/>
				</Anchors>
			</Frame>
