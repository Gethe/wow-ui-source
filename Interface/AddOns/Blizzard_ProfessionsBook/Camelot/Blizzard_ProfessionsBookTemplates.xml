	<Frame name="ProfessionsBookFrameTemplate" virtual="true">
		<Frames>
			<Frame parentKey="ProfessionsContentFrame">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent" relativePoint="TOPLEFT"/>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent" relativePoint="BOTTOMRIGHT"/>
				</Anchors>
				<Frames>
					<Frame parentKey="PrimaryProfession1" inherits="PrimaryProfessionTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" x="5" y="-41"/>
						</Anchors>
					</Frame>
					<Frame parentKey="PrimaryProfession2" inherits="PrimaryProfessionTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.PrimaryProfession1" relativePoint="BOTTOMLEFT" x="0" y="5"/>
						</Anchors>
						<Scripts>
							<OnLoad>
								self.missingHeader:SetText(PROFESSIONS_SECOND_PROFESSION);
							</OnLoad>
						</Scripts>
					</Frame>
					<Frame parentKey="SecondaryProfession1" inherits="SecondaryProfessionTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.PrimaryProfession2" relativePoint="BOTTOMLEFT" x="0" y="4"/>
						</Anchors>
						<Scripts>
							<OnLoad>
								self.Background:SetAtlas("Profession-overview-card-generic-cooking", true);
								self.missingHeader:SetText(PROFESSIONS_COOKING);
								self.missingText:SetText(PROFESSIONS_COOKING_MISSING);
							</OnLoad>
						</Scripts>
					</Frame>
					<Frame parentKey="SecondaryProfession2" inherits="SecondaryProfessionTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.SecondaryProfession1" relativePoint="TOPRIGHT" x="-6"/>
						</Anchors>
						<Scripts>
							<OnLoad>
								self.Background:SetAtlas("Profession-overview-card-generic-fishing", true);
								self.missingHeader:SetText(PROFESSIONS_FISHING);
								self.missingText:SetText(PROFESSIONS_FISHING_MISSING);
							</OnLoad>
						</Scripts>
					</Frame>
					<Frame parentKey="SecondaryProfession3" inherits="SecondaryProfessionTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.SecondaryProfession2" relativePoint="TOPRIGHT" x="-6"/>
						</Anchors>
						<Scripts>
							<OnLoad>
								self.Background:SetAtlas("Profession-overview-card-generic-firstaid", true);
								self.missingHeader:SetText(PROFESSIONS_FIRST_AID);
								self.missingText:SetText(PROFESSIONS_FIRST_AID_MISSING);
							</OnLoad>
						</Scripts>
					</Frame>
				</Frames>
			</Frame>
		</Frames>
