						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnClick method="OnClick"/>
					<OnEnter method="OnEnter"/>
					<OnLeave function="GameTooltip_Hide"/>
				</Scripts>
				<NormalTexture atlas="checkbox-minimal" useAtlasSize="true"/>
				<PushedTexture atlas="checkbox-minimal" useAtlasSize="true"/>
				<CheckedTexture atlas="checkmark-minimal" useAtlasSize="true"/>
				<DisabledCheckedTexture atlas="checkmark-minimal-disabled" useAtlasSize="true"/>
			</CheckButton>
			<Button parentKey="CurrencyTransferToggleButton" inherits="CurrencyTransferToggleButtonTemplate">
				<Anchors>
					<Anchor point="TOP" relativeKey="$parent.BackpackCheckbox" relativePoint="BOTTOM" x="60" y="-8"/>
				</Anchors>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
		</Scripts>
	</Frame>

