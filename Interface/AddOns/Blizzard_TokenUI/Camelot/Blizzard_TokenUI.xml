					<Anchor point="TOPLEFT" relativeKey="$parent.Footer" relativePoint="TOPLEFT" x="-4" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Label" inherits="GameFontNormal" text="UNUSED" justifyH="LEFT">
							<Size x="158" y="0"/>
