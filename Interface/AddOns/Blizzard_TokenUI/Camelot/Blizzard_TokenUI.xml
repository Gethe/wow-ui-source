			</CheckButton>
			<CheckButton parentKey="BackpackCheckbox" mixin="BackpackCurrencyCheckboxMixin">
				<Size x="26" y="26"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.InactiveCheckbox" relativePoint="BOTTOMLEFT" x="0" y="-2"/>
				</Anchors>
				<Layers>
