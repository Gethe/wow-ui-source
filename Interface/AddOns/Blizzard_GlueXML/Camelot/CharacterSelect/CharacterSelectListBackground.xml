<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\..\Blizzard_SharedXML\UI.xsd">
	<Frame name="CharacterSelectListBGTemplate" virtual="true">
		<Anchors>
			<Anchor point="TOPLEFT" relativeKey="$parent" relativePoint="TOPLEFT" x="0" y="0"/>
			<Anchor point="BOTTOMRIGHT" relativeKey="$parent" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Backdrop" atlas="heavybronze-frame-background" setAllPoints="true"/>
			</Layer>
			<Layer level="BORDER">
				<Texture parentKey="BackdropBorder" atlas="heavybronze-frame-basic">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent" relativePoint="TOPLEFT" x="-9" y="15"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent" relativePoint="BOTTOMRIGHT" x="9" y="-15"/>
					</Anchors>
				</Texture>
				<Texture atlas="heavybronze-vert-cornerbracket-TR" useAtlasSize="true">
					<Anchors>
						<Anchor point="TOPRIGHT" relativeKey="$parent.BackdropBorder" relativePoint="TOPRIGHT" x="0" y="0"/>
					</Anchors>
				</Texture>
				<Texture atlas="heavybronze-vert-cornerbracket-BR" useAtlasSize="true">
					<Anchors>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.BackdropBorder" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>


</Ui>
