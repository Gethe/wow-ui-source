<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\Blizzard_SharedXML\UI.xsd">

	<CheckButton name="SuperDistrictButtonTemplate" mixin="SuperDistrictButtonMixin" virtual="true">
		<Size x="260" y="530"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" atlas="Mode-Selection-Card-Regular" useAtlasSize="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Title" inherits="GlueFontNormalLarge" justifyV="MIDDLE" justifyH="CENTER">
					<Anchors>
						<Anchor point="TOP" x="0" y="-69"/>
					</Anchors>
				</FontString>
				<Texture name="$parentIcon" parentKey="Icon">
					<Size x="64" y="64"/>
					<Anchors>
						<Anchor point="TOP" relativeKey="$parent.Title" relativePoint="BOTTOM" x="-3" y="-25" />
					</Anchors>
				</Texture>
				<MaskTexture parentKey="CircleMask" atlas="CircleMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Icon" x="0" y="-3"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Icon" x="0" y="0"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="Icon"/>
					</MaskedTextures>
				</MaskTexture>
				<FontString parentKey="Description" inherits="GlueFontHighlight" justifyV="TOP" justifyH="CENTER">
					<Size x="180" y="260"/>
					<Anchors>
						<Anchor point="TOP" relativeKey="$parent.Icon" relativePoint="BOTTOM" x="3" y="-40" />
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="Circle" atlas="Mode-Selection-Ring" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.Icon" x="0" y="0"/>
					</Anchors>					
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick method="OnClick"/>
		</Scripts>
		<CheckedTexture atlas="Mode-Selection-Card-Regular-yellow-glow" useAtlasSize="true"/>
	</CheckButton>

	<ModelFFX name="SuperDistrictUI" toplevel="true" parent="GlueParent" setAllPoints="true" enableMouse="true" enableKeyboard="true" hidden="true" fogNear="0" fogFar="1200" glow="0.08" mixin="SuperDistrictMixin">
		<Layers>
			<Layer level="ARTWORK" textureSubLevel="1">
				<Texture setAllPoints="true">
					<Color a="0.75" r="0" g="0" b="0"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK" textureSubLevel="2">
				<FontString parentKey="Title" text="SUPER_DISTRICT_TITLE" inherits="SystemFont_Huge2" justifyV="MIDDLE" justifyH="CENTER">
					<Anchors>
						<Anchor point="CENTER" x="0" y="340"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Description" text="SUPER_DISTRICT_DESCRIPTION" inherits="GlueFontNormalLarge" justifyV="MIDDLE" justifyH="CENTER">
					<Anchors>
						<Anchor point="TOP" relativeKey="$parent.Title" relativePoint="BOTTOM" x="0" y="-16"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="BlackBars" setAllPoints="true">
				<Layers>
					<Layer level="OVERLAY">
						<Texture parentKey="Left">
							<Size x="1024" y="0"/>
							<Anchors>
								<Anchor point="TOPRIGHT" relativePoint="TOPLEFT"/>
								<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMLEFT"/>
							</Anchors>
							<Color r="0" g="0" b="0" a="1"/>
						</Texture>
						<Texture parentKey="Right">
							<Size x="1024" y="0"/>
							<Anchors>
								<Anchor point="TOPLEFT" relativePoint="TOPRIGHT"/>
								<Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT"/>
							</Anchors>
							<Color r="0" g="0" b="0" a="1"/>
						</Texture>
						<Texture parentKey="Top">
							<Size x="0" y="768"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT" relativeKey="$parent.Left"/>
								<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" relativeKey="$parent.Right"/>
							</Anchors>
							<Color r="0" g="0" b="0" a="1"/>
						</Texture>
					</Layer>
				</Layers>
			</Frame>
			<Frame parentKey="ButtonLayout" inherits="HorizontalLayoutFrame">
				<Size x="1" y="1"/>
				<KeyValues>
					<KeyValue key="spacing" value="22" type="number"/>
				</KeyValues>
				<Anchors>
					<Anchor point="CENTER" x="0" y="-30"/>
				</Anchors>
			</Frame>
			<DropdownButton parentKey="SubRegionDropdown" inherits="WowStyle1DropdownTemplate">
				<Anchors>
					<Anchor point="TOP" relativeKey="$parent.Description" relativePoint="BOTTOM" x="0" y="-25"/>
				</Anchors>
			</DropdownButton>
			<Button parentKey="SelectButton" inherits="GlueButtonBigTemplate" text="SUPER_DISTRICT_SELECT">
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-7" y="9"/>
				</Anchors>
				<NormalFont style="GlueFontNormalLogin"/>
				<HighlightFont style="GlueFontHighlightLogin"/>
				<DisabledFont style="GlueFontDisableLogin"/>
				<Scripts>
					<OnClick>
						EventRegistry:TriggerEvent("SuperDistrict.ConfirmSuperDistrict");
					</OnClick>
				</Scripts>
			</Button>
			<Button parentKey="CancelButton" inherits="GlueButtonBigTemplate" text="CANCEL">
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="7" y="9"/>
				</Anchors>
				<NormalFont style="GlueFontNormalLogin"/>
				<HighlightFont style="GlueFontHighlightLogin"/>
				<DisabledFont style="GlueFontDisableLogin"/>
				<Scripts>
					<OnClick>
						EventRegistry:TriggerEvent("SuperDistrict.CancelSelection");
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnEvent method="OnEvent"/>
		</Scripts>
	</ModelFFX>
</Ui>
